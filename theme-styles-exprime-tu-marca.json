    "cssCustom": ":root {\n  /* Brand Colors */\n  --color-ink-black: #000814ff;\n  --color-prussian-blue: #001d3dff;\n  --color-regal-navy: #003566ff;\n  --color-school-bus-yellow: #ffc300ff;\n  --color-gold: #ffd60aff;\n  --color-molten-lava: #780000ff;\n  --color-brick-red: #c1121fff;\n  \n  /* Gradients */\n  --gradient-primary: linear-gradient(135deg, #001d3dff 0%, #003566ff 100%);\n  --gradient-accent: linear-gradient(135deg, #ffc300ff 0%, #ffd60aff 100%);\n  --gradient-dark: linear-gradient(180deg, #000814ff 0%, #001d3dff 100%);\n  --gradient-warm: linear-gradient(135deg, #ffc300ff 0%, #c1121fff 100%);\n  \n  /* Spacing Scale */\n  --space-xs: 8px;\n  --space-sm: 16px;\n  --space-md: 24px;\n  --space-lg: 32px;\n  --space-xl: 48px;\n  --space-2xl: 64px;\n  --space-3xl: 96px;\n  --space-4xl: 128px;\n  \n  /* Typography Scale */\n  --text-xs: 0.75rem;\n  --text-sm: 0.875rem;\n  --text-base: 1rem;\n  --text-lg: 1.125rem;\n  --text-xl: 1.25rem;\n  --text-2xl: 1.5rem;\n  --text-3xl: 2rem;\n  --text-4xl: 2.5rem;\n  --text-5xl: 3rem;\n  --text-6xl: 4rem;\n  --text-7xl: 5rem;\n  \n  /* Font Families */\n  --font-heading: 'Onest', sans-serif;\n  --font-body: 'Manrope', sans-serif;\n  \n  /* Border Radius */\n  --radius-sm: 4px;\n  --radius-md: 8px;\n  --radius-lg: 12px;\n  --radius-xl: 16px;\n  --radius-full: 9999px;\n  \n  /* Shadows */\n  --shadow-sm: 0 1px 2px 0 rgba(0, 8, 20, 0.05);\n  --shadow-md: 0 4px 6px -1px rgba(0, 8, 20, 0.1), 0 2px 4px -1px rgba(0, 8, 20, 0.06);\n  --shadow-lg: 0 10px 15px -3px rgba(0, 8, 20, 0.1), 0 4px 6px -2px rgba(0, 8, 20, 0.05);\n  --shadow-xl: 0 20px 25px -5px rgba(0, 8, 20, 0.1), 0 10px 10px -5px rgba(0, 8, 20, 0.04);\n  --shadow-2xl: 0 25px 50px -12px rgba(0, 8, 20, 0.25);\n  \n  /* Transitions */\n  --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);\n  --transition-base: 300ms cubic-bezier(0.4, 0, 0.2, 1);\n  --transition-slow: 500ms cubic-bezier(0.4, 0, 0.2, 1);\n  \n  /* Container Widths */\n  --container-max: 1400px;\n  --container-content: 800px;\n}\n\n/* Smooth scrolling */\nhtml {\n  scroll-behavior: smooth;\n}\n\n/* Selection color */\n::selection {\n  background-color: var(--color-school-bus-yellow);\n  color: var(--color-ink-black);\n}\n\n/* Focus styles for accessibility */\n:focus-visible {\n  outline: 3px solid var(--color-gold);\n  outline-offset: 2px;\n}\n\n/* Gradient text utility */\n.gradient-text-primary {\n  background: var(--gradient-primary);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n.gradient-text-accent {\n  background: var(--gradient-accent);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n/* Premium hover effect */\n.premium-hover {\n  transition: all var(--transition-base);\n}\n\n.premium-hover:hover {\n  transform: translateY(-4px);\n  box-shadow: var(--shadow-xl);\n}"
